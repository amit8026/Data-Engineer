{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-healthcaresync"
		},
		"LS_ADLS_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_ADLS'"
		},
		"LS_PostgreSql_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_PostgreSql'"
		},
		"LS_ADLS_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://heathcaresync.dfs.core.windows.net/"
		},
		"LS_PostgreSql_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "ep-quiet-art-az4bdir4-pooler.c-3.ap-southeast-1.aws.neon.tech"
		},
		"LS_PostgreSql_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "neondb"
		},
		"LS_PostgreSql_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "neondb_owner"
		},
		"LS_adb_healthsync_properties_typeProperties_existingClusterId": {
			"type": "string",
			"defaultValue": "1028-045753-ycm019y3"
		},
		"LS_keyVault_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://healthcaresync.vault.azure.net/"
		},
		"LS_sql_metadata_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "healthcaresync.database.windows.net"
		},
		"LS_sql_metadata_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "free-sql-db-7916649"
		},
		"LS_sql_metadata_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "sql"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-healthcaresync_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_ADLS_accountKey": {
						"value": "[parameters('LS_ADLS_accountKey')]"
					},
					"LS_PostgreSql_password": {
						"value": "[parameters('LS_PostgreSql_password')]"
					},
					"LS_ADLS_properties_typeProperties_url": {
						"value": "[parameters('LS_ADLS_properties_typeProperties_url')]"
					},
					"LS_PostgreSql_properties_typeProperties_server": {
						"value": "[parameters('LS_PostgreSql_properties_typeProperties_server')]"
					},
					"LS_PostgreSql_properties_typeProperties_database": {
						"value": "[parameters('LS_PostgreSql_properties_typeProperties_database')]"
					},
					"LS_PostgreSql_properties_typeProperties_username": {
						"value": "[parameters('LS_PostgreSql_properties_typeProperties_username')]"
					},
					"LS_keyVault_properties_typeProperties_baseUrl": {
						"value": "[parameters('LS_keyVault_properties_typeProperties_baseUrl')]"
					},
					"LS_adb_healthsync_properties_typeProperties_existingClusterId": {
						"value": "[parameters('LS_adb_healthsync_properties_typeProperties_existingClusterId')]"
					},
					"LS_sql_metadata_properties_typeProperties_server": {
						"value": "[parameters('LS_sql_metadata_properties_typeProperties_server')]"
					},
					"LS_sql_metadata_properties_typeProperties_database": {
						"value": "[parameters('LS_sql_metadata_properties_typeProperties_database')]"
					},
					"LS_sql_metadata_properties_typeProperties_userName": {
						"value": "[parameters('LS_sql_metadata_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}