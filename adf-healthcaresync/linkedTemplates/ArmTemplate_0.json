				"type": "AzureSqlDatabase",
				"typeProperties": {
					"server": "[parameters('LS_sql_metadata_properties_typeProperties_server')]",
					"database": "[parameters('LS_sql_metadata_properties_typeProperties_database')]",
					"encrypt": "mandatory",
					"trustServerCertificate": false,
					"authenticationType": "SQL",
					"userName": "[parameters('LS_sql_metadata_properties_typeProperties_userName')]",
					"password": {
						"type": "AzureKeyVaultSecret",
						"store": {
							"referenceName": "LS_keyVault",
							"type": "LinkedServiceReference"
